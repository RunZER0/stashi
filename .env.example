# Public product defaults
NEXT_PUBLIC_DB_HOST=db.ynai.co.ke
NEXT_PUBLIC_DB_PORT=6432
NEXT_PUBLIC_AUTH_URL=https://auth.mystashi.online

# Control-plane database connection
# Production target is Stashi Postgres through PgBouncer on 6432 with TLS
CONTROL_PLANE_DATABASE_URL=

# Stashi Auth canonical identity configuration
# In production, this MUST strictly equal https://auth.mystashi.online
BETTER_AUTH_URL=https://auth.mystashi.online
BETTER_AUTH_SECRET=

# Social Identity Providers (Google & GitHub)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email & Verification Configuration
EMAIL_FROM="Stashi Auth <auth@mystashi.online>"
RESEND_API_KEY=
AUTH_REQUIRE_EMAIL_VERIFY=false

# MCP & Compatibility Settings
AUTH_ENABLE_LEGACY_DCR=false
AUTH_ALLOW_LOCAL_CIMD=false

# Node Agent & Backup Infrastructure
STASHI_AGENT_SHARED_SECRET=
PROVISIONER_SECRET=
BACKUP_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
