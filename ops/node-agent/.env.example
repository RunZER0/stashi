# Stashi Node Agent Configuration
# Place real configuration in /etc/stashi/agent.env with permissions 0600 (owned by root:stashi-agent)

# Node Identity
STASHI_NODE_ID=node-nj-01
STASHI_REGION=us-east
STASHI_PUBLIC_HOST=db.ynai.co.ke
STASHI_PGBOUNCER_PORT=6432
STASHI_PG_LOCAL_PORT=5432

# Control Plane Dispatcher
STASHI_CONTROL_PLANE_URL=https://api.stashi.dev
STASHI_AGENT_SHARED_SECRET=replace_with_high_entropy_hmac_key_min_64_chars

# Storage & Backups (Cloudflare R2 / S3)
R2_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET=stashi-backups
AWS_ACCESS_KEY_ID=replace_with_r2_access_key
AWS_SECRET_ACCESS_KEY=replace_with_r2_secret_key

# Polling Intervals (seconds)
STASHI_JOB_POLL_INTERVAL_SEC=5
STASHI_METRICS_INTERVAL_SEC=60
