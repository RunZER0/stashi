[Unit]
Description=Stashi PostgreSQL Node Agent
After=network.target postgresql@17-main.service pgbouncer.service
Wants=postgresql@17-main.service pgbouncer.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stashi-agent
EnvironmentFile=-/etc/stashi/agent.env
ExecStart=/usr/bin/node /opt/stashi-agent/agent.js
Restart=always
RestartSec=5s

# Security Hardening
# ProtectSystem=full makes /etc read-only, which breaks the tenant-provisioning
# flow: the agent needs to append/remove SCRAM hashes in
# /etc/pgbouncer/userlist.txt as part of create/rotate/delete jobs. Keep /etc
# protected everywhere else and carve out only that one path.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/etc/pgbouncer
ProtectHome=true
PrivateTmp=true
MemoryHigh=150M
MemoryMax=250M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stashi-agent

[Install]
WantedBy=multi-user.target
