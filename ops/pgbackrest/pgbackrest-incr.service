# Daily incremental backup. pgBackRest automatically chains from the latest
# full/diff backup; if the stanza has no prior backup yet it falls back to
# a full backup on its own. Install to /etc/systemd/system/.
[Unit]
Description=Stashi pgBackRest daily incremental backup
After=postgresql@17-main.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/pgbackrest --stanza=main --type=incr backup
